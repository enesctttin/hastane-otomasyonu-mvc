@{
}


@using HastaneMVC.DTOs
@model BransModelDTO

@{
    ViewData["Title"] = "Yeni Branş Ekle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-plus-circle-dotted"></i> Yeni Branş Kaydı</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Ekle" method="post">
                        
                        <div class="mb-4">
                            <label asp-for="BransAdi" class="form-label fw-bold">Branş Adı</label>
                            <input asp-for="BransAdi" class="form-control form-control-lg"
                                   placeholder="Örn: Kardiyoloji, Göz Hastalıkları..." required />
                            <span asp-validation-for="BransAdi" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left"></i> Vazgeç
                            </a>
                            <button type="submit" class="btn btn-success px-5">
                                <i class="bi bi-check-lg"></i> Branşı Kaydet
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
