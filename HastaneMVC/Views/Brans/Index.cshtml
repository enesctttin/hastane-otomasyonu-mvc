@{
}
@using HastaneMVC.DTOs
@model IEnumerable<BransModelDTO>

@{
    ViewData["Title"] = "Branş Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-hospital"></i> Branş Yönetimi</h2>
        <a asp-action="Ekle" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Yeni Branş Ekle
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th style="width: 10%"># ID</th>
                        <th style="width: 60%">Branş Adı</th>
                        <th style="width: 30%" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.BransAdi</strong></td>
                            <td class="text-center">
                                <a asp-action="Guncelle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-2">
                                    <i class="bi bi-pencil-square"></i> Düzenle
                                </a>
                                <a asp-action="Sil" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    Henüz kayıtlı bir branş bulunamadı.
                </div>
            }
        </div>
    </div>
</div>