@using HastaneMVC.ViewModels
@model DoktorEkleVM

@{
    ViewData["Title"] = "Yeni Doktor Ekle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-person-plus-fill"></i> Yeni Doktor Kaydı</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Ekle" method="post">
                        
                        <div class="mb-4">
                            <label asp-for="YeniDoktor.AdSoyad" class="form-label fw-bold">Doktor Adı Soyadı</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="YeniDoktor.AdSoyad" class="form-control form-control-lg" placeholder="Örn: Dr. Ayşe Yılmaz" required />
                            </div>
                            <span asp-validation-for="YeniDoktor.AdSoyad" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="YeniDoktor.BransId" class="form-label fw-bold">Uzmanlık Alanı (Branş)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-hospital"></i></span>
                                <select asp-for="YeniDoktor.BransId" class="form-select form-select-lg"
                                        asp-items="@(new SelectList(Model.BransListesi, "Id", "BransAdi"))">
                                    <option value="">-- Lütfen Branş Seçiniz --</option>
                                </select>
                            </div>
                            <div class="form-text">Doktorun görev yapacağı polikliniği seçiniz.</div>
                            <span asp-validation-for="YeniDoktor.BransId" class="text-danger"></span>
                        </div>

                        <hr class="my-4">

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Listeye Dön</a>
                            <button type="submit" class="btn btn-primary px-5 fw-bold">
                                <i class="bi bi-save"></i> Doktoru Kaydet
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}