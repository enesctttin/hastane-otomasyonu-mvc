@using HastaneMVC.Models
@model IEnumerable<DoktorModel>

@{
    ViewData["Title"] = "Doktor Listesi";
}



<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-person-badge"></i> Doktor Yönetimi</h2>
        <a asp-action="Ekle" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Yeni Doktor Ekle
        </a>
    </div>

    
    <form asp-controller="Doktor" asp-action="Index" method="get" class="mb-4">
        <div class="input-group" style="max-width: 400px;">
            <span class="input-group-text bg-primary text-white">Branşa Göre Ara</span>
            <input type="text" name="ara" class="form-control" placeholder="Örn: Göz, Dahiliye..." />
            <button type="submit" class="btn btn-outline-primary fw-bold">Ara</button>
        </div>
    </form>

    
 

    <div class="card shadow border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th># ID</th>
                        <th>Doktor Adı Soyadı</th>
                        <th>Uzmanlık Alanı (Branş)</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doktor in Model)
                    {
                        <tr>
                            <td>@doktor.Id</td>
                            <td>
                                <span class="fw-bold">@doktor.AdSoyad</span>
                            </td>
                            <td>
                                @if (doktor.Brans != null)
                                {
                                    <span class="badge bg-info text-dark">@doktor.Brans.BransAdi</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Branş Atanmamış</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Guncelle" asp-route-id="@doktor.Id" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Sil" asp-route-id="@doktor.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center mt-3">
                    Henüz kayıtlı bir doktor bulunamadı.
                </div>
            }
        </div>
    </div>
</div>