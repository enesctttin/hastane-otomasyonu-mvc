@using HastaneMVC.Models
@model DoktorModel

@{
    ViewData["Title"] = "Doktor Sil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-exclamation-octagon"></i> Kaydı Silmek Üzeresiniz</h5>
                </div>
                <div class="card-body p-5">
                    <i class="bi bi-person-x-fill text-danger display-1"></i>
                    <h3 class="my-4">@Model.AdSoyad</h3>
                    <p class="text-muted">Bu doktoru sistemden tamamen silmek istediğinizden emin misiniz?</p>
                    
                    <form asp-action="Sil" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 me-2">Hayır, Vazgeç</a>
                            <button type="submit" class="btn btn-danger px-4">Evet, Kalıcı Olarak Sil</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>