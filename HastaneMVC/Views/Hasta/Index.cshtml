@using HastaneMVC.DTOs
@model IEnumerable<HastaModelDTO>

@{
    ViewData["Title"] = "Hasta Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success"><i class="bi bi-people-fill"></i> Hasta Yönetimi</h2>
        <a asp-action="Ekle" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i> Yeni Hasta Kaydı
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 10%"># ID</th>
                        <th style="width: 25%">TC Kimlik No</th>
                        <th style="width: 45%">Adı Soyadı</th>
                        <th style="width: 20%" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hasta in Model)
                    {
                        <tr>
                            <td>@hasta.Id</td>
                            <td><span class="badge bg-secondary">@hasta.TcNo</span></td>
                            <td class="fw-bold">@hasta.AdSoyad</td>
                            <td class="text-center">
                                <a asp-action="Guncelle" asp-route-id="@hasta.Id" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil-square"></i> Düzenle
                                </a>
                                <a asp-action="Sil" asp-route-id="@hasta.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center mt-3">
                    Sistemde henüz kayıtlı hasta bulunmuyor. Yeni bir hasta ekleyerek başlayabilirsiniz.
                </div>
            }
        </div>
    </div>
</div>