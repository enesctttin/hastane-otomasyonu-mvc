@using HastaneMVC.DTOs
@model IEnumerable<RandevuModelDTO>

@{
    ViewData["Title"] = "Randevu Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-calendar-check-fill"></i> Randevu Yönetimi</h2>
        <a asp-action="Ekle" class="btn btn-primary">
            <i class="bi bi-calendar-plus"></i> Yeni Randevu Oluştur
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 5%"># ID</th>
                        <th style="width: 20%">Tarih & Saat</th>
                        <th style="width: 25%">Hasta Bilgisi</th>
                        <th style="width: 35%">Doktor & Branş</th>
                        <th style="width: 15%" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var randevu in Model)
                    {
                        <tr>
                            <td>@randevu.Id</td>
                            <td>
                                <span class="badge bg-light text-dark border p-2">
                                    <i class="bi bi-clock"></i> @randevu.TarihSaat.ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </td>
                            <td class="fw-bold text-success">
                                <i class="bi bi-person"></i> @randevu.HastaAdSoyad
                            </td>
                            <td>
                                <i class="bi bi-file-medical"></i> @randevu.DoktorAdSoyad
                                <span class="badge bg-info text-dark ms-2">@randevu.BransAdi</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Guncelle" asp-route-id="@randevu.Id" class="btn btn-sm btn-outline-warning me-1" title="Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Sil" asp-route-id="@randevu.Id" class="btn btn-sm btn-outline-danger" title="İptal Et/Sil">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center mt-3">
                    <i class="bi bi-exclamation-circle"></i> Sistemde henüz oluşturulmuş bir randevu bulunmuyor.
                </div>
            }
        </div>
    </div>
</div>