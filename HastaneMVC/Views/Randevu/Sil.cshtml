@using HastaneMVC.Models
@using HastaneMVC.ViewModels
@model RandevuSilVM

@{
    ViewData["Title"] = "Randevu İptal / Sil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-calendar-x-fill"></i> Randevu İptal Onayı</h5>
                </div>
                <div class="card-body p-5">
                    <i class="bi bi-exclamation-circle text-danger display-1 mb-3"></i>
                    
                    <h4 class="fw-bold mt-3">@Model.randevu.HastaAdSoyad</h4>
                    <p class="text-muted fs-5 mb-1">Doktor: <strong>@Model.randevu.DoktorAdSoyad</strong></p>
                    @* <p class="text-muted fs-5">Tarih: <strong>@Model.TarihSaat.ToString("dd.MM.yyyy HH:mm")</strong></p> *@
                    
                    <div class="alert alert-warning mt-4 text-start">
                        <i class="bi bi-info-circle"></i> <strong>Uyarı:</strong> Bu randevuyu sistemden kalıcı olarak silmek üzeresiniz.
                    </div>
                    
                    <form asp-action="Sil" method="post">
                        <input type="hidden" name="id" value="@Model.randevu.Id" />
                        <div class="mt-4 d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Hayır, Vazgeç</a>
                            <button type="submit" class="btn btn-danger px-5 fw-bold">
                                <i class="bi bi-trash3-fill"></i> Evet, Randevuyu İptal Et
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>