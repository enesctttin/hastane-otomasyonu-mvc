@using HastaneMVC.DTOs
@model IEnumerable<RandevuTahlilModelDTO>

@{
    ViewData["Title"] = "Randevu Tahlil Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-clipboard2-pulse"></i> Randevu Tahlil Listesi</h2>
        <a asp-action="Ekle" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle"></i> Yeni Tahlil İsteği Oluştur
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3"># ID</th>
                        <th>Hasta Adı Soyadı</th>
                        <th>Yönlendiren Doktor</th>
                        <th>İstenen Tahlil</th>
                        <th>Tahlil Sonucu</th>
                        <th class="text-center pe-3">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">@item.Id</td>
                            <td><i class="bi bi-person-fill text-secondary"></i> @item.HastaAdSoyad</td>
                            <td><i class="bi bi-heart-pulse text-danger"></i> @item.DoktorAdSoyad</td>
                            <td><span class="badge bg-info text-dark fs-6">@item.TahlilAd</span></td>
                            
                            <td>
                                @if (item.Sonuc == "Sonuç henüz çıkmadı / Bekleniyor.")
                                {
                                    <span class="text-warning fw-bold"><i class="bi bi-hourglass-split"></i> @item.Sonuc</span>
                                }
                                else
                                {
                                    <span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> @item.Sonuc</span>
                                }
                            </td>
                            
                            <td class="text-center pe-3">
                                <a asp-action="Guncelle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil-square"></i> Sonuç Gir / Düzenle
                                </a>
                                <a asp-action="Sil" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> İptal Et
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-secondary m-4 text-center fs-5">
                    <i class="bi bi-info-circle fs-4"></i> Sisteme henüz hiçbir randevu tahlil eşleşmesi girilmemiş. Yukarıdaki butondan yeni bir tahlil isteği oluşturabilirsiniz!
                </div>
            }
        </div>
    </div>
</div>