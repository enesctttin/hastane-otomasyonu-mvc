<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HastaneMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HastaneMVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

            @* tostr *@
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />



    <style>
            /* Menünün üzerine gelince hafif parlaması için ufak bir dokunuş */
            .navbar-nav .nav-link:hover {
                background-color: rgba(255, 255, 255, 0.1);
                border-radius: 5px;
            }
            /* Sayfa içeriği az olsa bile footer'ın hep en altta kalması için */
            html, body { height: 100%; }
            body { display: flex; flex-direction: column; }
            .container-main { flex: 1; }
    </style>



</head>
<body class="bg-light">
    
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-hospital text-white"></i> Hastane<span class="text-warning">MVC</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#hastaneMenu" aria-controls="hastaneMenu" aria-expanded="false" aria-label="Menüyü Aç">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="hastaneMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Brans" asp-action="Index">
                                <i class="bi bi-diagram-3"></i> Branşlar
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Doktor" asp-action="Index">
                                <i class="bi bi-person-badge"></i> Doktorlar
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Hasta" asp-action="Index">
                                <i class="bi bi-people"></i> Hastalar
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Randevu" asp-action="Index">
                                <i class="bi bi-calendar2-check"></i> Randevular
                            </a>
                        </li>


                          <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="TahlilTur" asp-action="Index">
                                <i class="bi bi-calendar2-check"></i> Tahlil Türü
                            </a>
                        </li>


                          <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="RandevuTahlil" asp-action="Index">
                                <i class="bi bi-calendar2-check"></i> Tahlil Sonuçları 
                            </a>
                        </li>




                    </ul>
                    

                </div>
            </div>
        </nav>
    </header>
    <div class="container container-main">
        <main role="main" class="pb-3">

            @RenderBody() </main>
           <partial name="Toast" />


    </div>

    <footer class="bg-white border-top text-muted py-4 mt-5">
        <div class="container text-center">
            <span class="fw-bold text-primary"><i class="bi bi-heart-pulse-fill text-danger"></i> Hastane Otomasyonu</span> &copy; 2026 - Tüm Hakları Saklıdır.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

        @* @await Html.PartialAsync("Toast")    // yukarıda             @RenderBody() </main> üstünde tanımladık, böylece tüm view'larda toast mesajları gösterilebilir
  *@

    @await RenderSectionAsync("Scripts", required: false)
    @*  required true olursa oluşturulan her view de bu kısım tanımlanmalı *@
</body>
</html>
