@using HastaneMVC.DTOs
@model TahlilTurModelDTO

@{
    ViewData["Title"] = "Tahlil Türü Sil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Tahlil Türü Silme Onayı</h5>
                </div>
                <div class="card-body p-5">
                    <i class="bi bi-trash text-danger display-1 mb-3"></i>
                    
                    <h3 class="fw-bold text-dark mt-3">@Model.Ad</h3>
                    
                    <div class="alert alert-warning mt-4 text-start">
                        <i class="bi bi-info-circle"></i> <strong>Uyarı:</strong> Bu tahlil türünü (Örn: Kan, MR) sistemden kalıcı olarak silmek üzeresiniz.
                    </div>
                    
                    <form asp-action="Sil" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mt-4 d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Hayır, Vazgeç</a>
                            <button type="submit" class="btn btn-danger px-5 fw-bold">
                                <i class="bi bi-trash3-fill"></i> Evet, Kalıcı Olarak Sil
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>